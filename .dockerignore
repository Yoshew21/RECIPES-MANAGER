# Dependencies (rebuilt in image)
node_modules/
npm-debug.log*

# Environment variables (injected via docker-compose)
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Docker files (not needed inside the image)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Documentation
README.md
*.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Build outputs
dist/
build/
out/

# Tailwind CSS build output (not used, Tailwind is loaded via CDN)
public/css/output.css
public/css/output.css.map

# Temporary files
*.tmp
*.temp
.cache/
tmp/
temp/

# Tests
coverage/
.nyc_output/
*.test.js
*.spec.js

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
