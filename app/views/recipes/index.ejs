<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/head', {title: 'Gestionnaire de recettes | Recipe Manager'}); %>
</head>
<body>
<div class="container mx-auto px-4 py-8 max-w-7xl">
    <div class="text-center mb-12">
        <h1 class="text-6xl font-light text-rose-300 mb-4 tracking-wide">RECIPE MANAGER</h1>
        <div class="max-w-2xl mx-auto">
            <p class="text-xl text-slate-400 font-light">Gérez vos recettes avec sérénité</p>
        </div>
    </div>
    <div class="mb-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
            <h2 class="text-3xl font-light text-slate-500">VOS RECETTES</h2>
            <div class="flex flex-wrap items-center gap-3">
                <form action="/recipes" method="GET" class="flex flex-wrap items-center gap-3">
                    <input
                        type="text"
                        name="q"
                        value="<%= q || '' %>"
                        placeholder="Rechercher dans les recettes..."
                        class="px-5 py-3 text-base border-2 border-pink-200 rounded-2xl bg-white/80 backdrop-blur-sm text-slate-600 focus:outline-none focus:border-pink-300 transition-all shadow-sm hover:shadow-md"
                    >

                    <select
                        class="px-5 py-3 text-base border-2 border-pink-200 rounded-2xl bg-white/80 backdrop-blur-sm text-slate-600 focus:outline-none focus:border-pink-300 transition-all shadow-sm hover:shadow-md"
                        id="categoryFilter"
                        name="categoryId"
                        onchange="this.form.submit()"
                    >
                        <option value="">Toutes les catégories</option>
                        <% categories.forEach(category => { %>
                            <option value="<%= category.id %>" <%= selectedCategory === category.id ? 'selected' : '' %>>
                                <%= category.name %>
                            </option>
                        <% }) %>
                    </select>

                    <label class="cursor-pointer bg-white/80 border-2 border-pink-200 rounded-2xl px-5 py-3 text-slate-600 hover:border-pink-300 transition-all shadow-sm flex items-center gap-3 group">
                        <input
                            type="checkbox"
                            name="byIngredients"
                            id="byIngredients"
                            value="1"
                            <%= byIngredients ? 'checked' : '' %>
                            class="sr-only peer"
                        >
                        <div class="w-6 h-6 border-2 border-pink-200 rounded-lg flex items-center justify-center peer-checked:bg-pink-400 peer-checked:border-pink-400 transition-all group-hover:border-pink-300">
                            <svg class="w-4 h-4 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <span class="font-medium">Par ingrédients</span>
                    </label>

                    <div id="ingredientsFilter" class="relative <%= byIngredients ? '' : 'hidden' %>">
                        <button type="button" id="ingredientsDropdownButton" class="px-5 py-3 text-base border-2 border-emerald-200 rounded-2xl bg-white/80 backdrop-blur-sm text-slate-600 focus:outline-none focus:border-emerald-300 transition-all shadow-sm hover:shadow-md flex items-center gap-3 min-w-[220px] justify-between">
                            <span id="dropdownLabel">Sélectionner les ingrédients</span>
                            <svg class="w-5 h-5 text-emerald-400 transition-transform duration-200" id="dropdownArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        
                        <div id="ingredientsDropdown" class="hidden absolute z-50 mt-2 w-full min-w-[250px] max-h-72 overflow-y-auto bg-white/95 backdrop-blur-md border-2 border-emerald-100 rounded-2xl shadow-2xl p-2 animate-in fade-in slide-in-from-top-2 duration-200">
                            <div class="sticky top-0 bg-white/95 backdrop-blur-md pb-2 mb-2 border-b border-emerald-50">
                                <input type="text" id="ingredientSearch" placeholder="Filtrer..." class="w-full px-3 py-2 text-sm border border-emerald-100 rounded-xl focus:outline-none focus:border-emerald-300 bg-emerald-50/30">
                            </div>
                            <div id="ingredientsList">
                                <% (allIngredients || []).forEach(ing => { %>
                                    <label class="ingredient-item flex items-center gap-3 p-2.5 hover:bg-emerald-50 rounded-xl cursor-pointer transition-colors group">
                                        <input type="checkbox" name="ingredients" value="<%= ing %>" <%= (selectedIngredients || []).includes(String(ing).toLowerCase()) ? 'checked' : '' %> class="w-5 h-5 rounded border-emerald-200 text-emerald-500 focus:ring-emerald-500 accent-emerald-500">
                                        <span class="text-slate-600 text-sm group-hover:text-emerald-700 transition-colors"><%= ing %></span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="bg-pink-200 hover:bg-pink-300 text-pink-700 font-medium py-3 px-6 rounded-2xl transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5">
                        Rechercher
                    </button>
                </form>
                <a href="/categories" class="bg-purple-200 hover:bg-purple-300 text-purple-700 font-medium py-3 px-6 rounded-2xl transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5">VOIR LES CATÉGORIES</a>
                <a href="/recipes/new" class="bg-emerald-200 hover:bg-emerald-300 text-emerald-700 font-medium py-3 px-6 rounded-2xl transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5">AJOUTER UNE RECETTE</a>
            </div>
        </div>
        <% if(recipes.length > 0) { %>
            <div class="grid gap-6">
                <% for(const recipe of recipes) { %>
                    <div class="bg-white/70 backdrop-blur-sm rounded-3xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-pink-100/50">
                        <div class="flex flex-col md:flex-row">
                            <% if (recipe.imageBase64) { %>
                                <div class="md:w-48 flex items-center justify-center p-4 bg-gradient-to-br from-pink-50 to-purple-50">
                                    <img src="data:image/png;base64,<%= recipe.imageBase64 %>" class="w-full max-w-32 h-32 object-cover rounded-2xl shadow-md" alt="Recipe Image">
                                </div>
                            <% } %>
                            <div class="flex-1 p-6">
                                <div class="flex flex-col md:flex-row justify-between gap-4">
                                    <div class="flex-1">
                                        <h5 class="text-2xl font-light text-slate-600 mb-3"><%= recipe.title %></h5>
                                        <div class="space-y-2 text-slate-500">
                                            <p class="flex items-center gap-2">
                                                <span class="text-slate-400">Créateur :</span>
                                                <span class="font-medium"><%= recipe.author %></span>
                                            </p>
                                            <p class="flex items-center gap-2">
                                                <span class="text-slate-400">Catégorie :</span>
                                                <span class="font-medium"><%= recipe.category ? recipe.category.name : 'Aucune catégorie' %></span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-2 min-w-[140px]">
                                        <a href="/recipes/<%= recipe.id %>" class="bg-slate-200 hover:bg-slate-300 text-slate-600 font-medium py-2.5 px-4 rounded-xl text-sm text-center transition-all shadow-sm hover:shadow-md">DÉTAILS</a>
                                        <a href="/recipes/<%= recipe.id %>/edit" class="bg-amber-200 hover:bg-amber-300 text-amber-700 font-medium py-2.5 px-4 rounded-xl text-sm text-center transition-all shadow-sm hover:shadow-md">MODIFIER</a>
                                        <a href="/recipes/<%= recipe.id %>/delete" class="bg-rose-200 hover:bg-rose-300 text-rose-700 font-medium py-2.5 px-4 rounded-xl text-sm text-center transition-all shadow-sm hover:shadow-md">SUPPRIMER</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <div class="inline-block bg-white/70 backdrop-blur-sm rounded-3xl p-12 shadow-lg border border-pink-100/50">
                    <h3 class="text-2xl font-light text-slate-400 mb-2">Il n'y a pas encore de recettes !</h3>
                    <p class="text-slate-300">Commencez par en ajouter une</p>
                </div>
            </div>
        <% } %>

        <% if (totalPages > 1) { %>
            <div class="flex justify-center items-center gap-4 mt-8">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&q=<%= encodeURIComponent(q || '') %>&categoryId=<%= selectedCategory || '' %>&byIngredients=<%= byIngredients ? '1' : '' %>&ingredients=<%= (selectedIngredients || []).join(',') %>" class="bg-pink-200 hover:bg-pink-300 text-pink-700 font-medium py-2 px-4 rounded-xl transition-all shadow-sm hover:shadow-md">Précédent</a>
                <% } %>
                <span class="text-slate-600">Page <%= currentPage %> sur <%= totalPages %></span>
                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&q=<%= encodeURIComponent(q || '') %>&categoryId=<%= selectedCategory || '' %>&byIngredients=<%= byIngredients ? '1' : '' %>&ingredients=<%= (selectedIngredients || []).join(',') %>" class="bg-pink-200 hover:bg-pink-300 text-pink-700 font-medium py-2 px-4 rounded-xl transition-all shadow-sm hover:shadow-md">Suivant</a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
    (function () {
        const checkbox = document.getElementById('byIngredients');
        const filterBox = document.getElementById('ingredientsFilter');
        const dropdownButton = document.getElementById('ingredientsDropdownButton');
        const dropdown = document.getElementById('ingredientsDropdown');
        const dropdownArrow = document.getElementById('dropdownArrow');
        const ingredientSearch = document.getElementById('ingredientSearch');
        const ingredientItems = document.querySelectorAll('.ingredient-item');
        const dropdownLabel = document.getElementById('dropdownLabel');

        if (!checkbox || !filterBox) return;

        // Toggle filter visibility
        checkbox.addEventListener('change', function () {
            filterBox.classList.toggle('hidden', !checkbox.checked);
        });

        // Toggle dropdown
        dropdownButton.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            dropdownArrow.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
            if (isHidden) ingredientSearch.focus();
        });

        // Update label with count
        function updateLabel() {
            const checkedCount = dropdown.querySelectorAll('input[type="checkbox"]:checked').length;
            if (checkedCount === 0) {
                dropdownLabel.textContent = 'Sélectionner les ingrédients';
            } else if (checkedCount === 1) {
                dropdownLabel.textContent = '1 ingrédient sélectionné';
            } else {
                dropdownLabel.textContent = `${checkedCount} ingrédients sélectionnés`;
            }
        }

        // Handle checkbox changes
        const checkboxes = dropdown.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                updateLabel();
            });
        });

        // Initial label update
        updateLabel();

        // Search/Filter ingredients
        ingredientSearch.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            ingredientItems.forEach(item => {
                const text = item.querySelector('span').textContent.toLowerCase();
                item.style.display = text.includes(term) ? 'flex' : 'none';
            });
        });

        // Close on click outside
        document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target) && !dropdownButton.contains(e.target)) {
                dropdown.classList.add('hidden');
                dropdownArrow.style.transform = 'rotate(0deg)';
            }
        });

        // Prevent dropdown close when clicking search input
        ingredientSearch.addEventListener('click', (e) => e.stopPropagation());
    })();
</script>
</body>
</html>