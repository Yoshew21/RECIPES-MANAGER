<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/head', {title: 'Categories Manager'}); %>
</head>
<body>
<div class="container mx-auto px-4 py-8 max-w-7xl">
    <div class="text-center mb-12">
        <h1 class="text-6xl font-light text-purple-300 mb-4 tracking-wide">CATEGORY MANAGER</h1>
        <div class="max-w-2xl mx-auto">
            <p class="text-xl text-slate-400 font-light">Gérez vos catégories avec sérénité</p>
        </div>
    </div>
    <div class="mb-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
            <h2 class="text-3xl font-light text-slate-500">VOS CATEGORIES</h2>
            <div class="flex flex-wrap gap-3">
                <a href="/recipes" class="bg-sky-200 hover:bg-sky-300 text-sky-700 font-medium py-3 px-6 rounded-2xl transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5">VOIR LES RECETTES</a>
                <a href="/categories/new" class="bg-emerald-200 hover:bg-emerald-300 text-emerald-700 font-medium py-3 px-6 rounded-2xl transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5">NOUVELLE CATEGORIE</a>
            </div>
        </div>
        <% if(categories.length > 0) { %>
            <div class="grid gap-6">
                <% for(const category of categories) { %>
                    <div class="bg-white/70 backdrop-blur-sm rounded-3xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-purple-100/50">
                        <div class="flex flex-col md:flex-row">
                            <div class="flex-1 p-6">
                                <h5 class="text-2xl font-light text-slate-600 mb-3"><%= category.name %></h5>
                                <p class="text-slate-500 mb-4 font-light"><%= category.description %></p>
                                <p class="text-slate-400 text-sm">
                                    <span class="font-medium">Nombre de recettes dans cette catégorie :</span> 
                                    <span class="bg-purple-100 text-purple-600 px-3 py-1 rounded-full"><%= category.recipesCount %></span>
                                </p>
                            </div>
                            <div class="md:w-48 flex items-center justify-center p-6 bg-gradient-to-br from-purple-50 to-pink-50">
                                <div class="flex flex-col gap-2 w-full">
                                    <a href="/categories/<%= category.id %>" class="bg-slate-200 hover:bg-slate-300 text-slate-600 font-medium py-2.5 px-4 rounded-xl text-sm text-center transition-all shadow-sm hover:shadow-md">DÉTAILS</a>
                                    <a href="/categories/<%= category.id %>/edit" class="bg-amber-200 hover:bg-amber-300 text-amber-700 font-medium py-2.5 px-4 rounded-xl text-sm text-center transition-all shadow-sm hover:shadow-md">MODIFIER</a>
                                    <a href="/categories/<%= category.id %>/delete" class="bg-rose-200 hover:bg-rose-300 text-rose-700 font-medium py-2.5 px-4 rounded-xl text-sm text-center transition-all shadow-sm hover:shadow-md">SUPPRIMER</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <div class="inline-block bg-white/70 backdrop-blur-sm rounded-3xl p-12 shadow-lg border border-purple-100/50">
                    <h3 class="text-2xl font-light text-slate-400 mb-2">Il n'y a pas encore de catégories !</h3>
                    <p class="text-slate-300">Commencez par en ajouter une</p>
                </div>
            </div>
        <% } %>

        <% if (totalPages > 1) { %>
            <div class="flex justify-center items-center gap-4 mt-8">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>" class="bg-purple-200 hover:bg-purple-300 text-purple-700 font-medium py-2 px-4 rounded-xl transition-all shadow-sm hover:shadow-md">Précédent</a>
                <% } %>
                <span class="text-slate-600">Page <%= currentPage %> sur <%= totalPages %></span>
                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>" class="bg-purple-200 hover:bg-purple-300 text-purple-700 font-medium py-2 px-4 rounded-xl transition-all shadow-sm hover:shadow-md">Suivant</a>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
</body>
</html>